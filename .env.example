DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/luggagefit?schema=public"
# In production: https://baggofit.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Shopify Global Catalog (product recommendations). Agent credentials from the Shopify Dev Dashboard
# (Agent → API credentials). Server-only secrets: never commit real values. Needed in production.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Optional: your own UCP agent profile URL (otherwise Shopify's hosted profile is used).
SHOPIFY_UCP_AGENT_PROFILE=""

# Optional saved catalogs from the Shopify Dev Dashboard (Catalogs). Their filters (categories, condition,
# images only…) bound every search. Leave empty to search the whole catalog.
SHOPIFY_CATALOG_ID=""
# Optional per-kind overrides:
SHOPIFY_CATALOG_ID_BACKPACKS=""
SHOPIFY_CATALOG_ID_LUGGAGE=""
